# fleet.env — machine topology for multi-machine runs.
#
#   cp fleet.env.example fleet.env   &&   edit   (fleet.env is gitignored)
#
# Scripts that read this: lane-bench.sh, deploy-lean.sh. Single-machine work
# (lean-smoke.sh, demo-metamask.sh) needs none of it.
#
# The first entry is THIS machine (validator1); the rest are remotes reached
# over tailscale ssh as $REMOTE_USER@<host>. IPs are used for the lean-lane
# peer mesh — prefer raw IPs over MagicDNS names: one machine in the original
# fleet had DNS disabled and its gossip pushes failed silently for a day.

FLEET_HOSTS=(localhost ginnythui papaduck papaduck-alien2)
FLEET_IPS=(100.124.148.61 100.85.150.119 100.70.62.92 100.86.97.40)
REMOTE_USER=papaduck

# Where the lean node binary, fund file and datadirs live on EVERY machine.
REMOTE_HOME=/home/papaduck
LEAN_BIN_REMOTE=$REMOTE_HOME/lean-lane-node
LEAN_FUND_REMOTE=$REMOTE_HOME/lean-fund.txt
LEAN_DATA_ROOT=$REMOTE_HOME/lean-lane
LEAN_PORT=8560

# Local build outputs (this repo).
LEAN_BIN=target/release/lean-lane-node
SPAMMER_BIN=target/release/spammer
FUND=$HOME/lean-fund.txt
FUND_ACCOUNTS=800
