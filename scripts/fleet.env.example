# fleet.env — the 4-machine lean-lane fleet. Copy to scripts/fleet.env and edit.
#
#   cp scripts/fleet.env.example scripts/fleet.env
#   scripts/fleet-lean.sh up
#
# validator1 is ALWAYS this machine (local docker + a local lean node); 2..4 are
# reached with `tailscale ssh $REMOTE_USER@<ip>`. Everything a run writes on a
# remote lives under $FLEET_ROOT/<run-id>/ and nothing else in $HOME is touched.

REMOTE_USER=papaduck
FLEET_ROOT=/home/papaduck/arc-runs

# validator index -> tailscale IP. Index 1 must be this machine.
FLEET_IPS=(x 100.124.148.61 100.85.150.119 100.70.62.92 100.86.97.40)
# friendly names, for the log lines only
FLEET_NAMES=(x ginny-alienware GinnyThui papaduck papaduck-alien2)

# lean-lane repo (node + spammer + gen-lean-fund.sh)
LEAN_LANE_DIR=/home/papaduck/lean-lane

# load shape for `up`/`load`. Every one of these is a DEFAULT ONLY: the
# process environment always wins over this file (fleet-lean.sh snapshots the
# caller's exports before sourcing this file and restores them after — see its
# header), so a sweep just does e.g.:
#   BUDGET_GAS=225000000 FANOUT=100 scripts/fleet-lean.sh up
#   FANOUT=100 LOAD_RATE=1500 scripts/fleet-lean.sh load
# without ever touching this file.
LOAD_SECS=600
LOAD_RATE=3000
FANOUT=50
POOL_TARGET=1500
FUND_ACCOUNTS=800
GENERATORS=2
DISTRIBUTED=0

# BUDGET_GAS is templated into a per-run copy of the scenario manifest (the
# tracked crates/quake/scenarios/fleet4-lean.toml is never edited). BUDGET_TXS
# — the tx count that fills a block at this budget and FANOUT — is derived
# automatically (budget_gas / (21000 + 5000*FANOUT)) unless set explicitly;
# 150 M @ N=50 => 553 txs is a 100 %-full block.
BUDGET_GAS=150000000
#BUDGET_TXS=553
